{
  "name": "@chess-kernel/core",
  "version": "0.1.0",
  "description": "Abstract game engine core with topology-agnostic board support",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
