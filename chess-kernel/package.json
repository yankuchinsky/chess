    "test:watch": "vitest"
  },
  "keywords": ["chess", "game-engine", "board-games", "hexagonal"],
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.4.0",
    "vitest": "^1.4.0",
    "@types/node": "^20.11.0"
  }
